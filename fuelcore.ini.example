[database]
driver = sqlite
test_only = yes
path = fuelcore_test.sqlite3
; MySQL: set driver = mysql and fill in the test-server settings below.
; host =
; port = 3306
; user =
; password =
; database = fuelcore_test
; code_database = fuelcore_test_code

[print]
printer =

[workflow]
check_after_convert = yes
archive_after_convert = yes

[app]
admin_password =

[other]
enabled = yes
fields = OTHER,EDIOTHER

[notify]
enabled = no
c3 = yes
c1a18 = yes
poll_seconds = 60
; Multiline PDF paths, relative to this INI or absolute. Use {SERSNO}, {BANAME}, {BAID}, {BYNAME}, or *.
c3_pdfs =
c1a18_pdfs =
; Blank uses the Windows PDF print association. A custom command must contain {file}.
print_command =

[logic_check]
; FUELCORE_LOGIC_PLUGIN can override this example path.
plugin_dir = C:\example\只放本機_邏輯檢查外掛
python_exe =
timeout_seconds = 120
; For MySQL use a dedicated test copy of cbssetcontent.
rules_database = cbssetcontent_test

[conversion]
user_code = USER1
cusboxno = Z000
write_codes = yes
other = 以油駁船方式為國際航線船加油報單數量單價價格
    係預購價值其確實數量以交貨紀錄單為準申請更正
    僅請准予報備

    本批貨物係供在港國際航線船舶就地採購專用燃料(油)

[buyer_countries]
AABRTG = JP 日本
ONSRME = HK 香港

